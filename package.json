{
  "name": "iobroker.kiwi",
  "version": "0.6.1",
  "description": "an MCP Server that controlls io-broker with AI from any MCP Client and an integrated ai powerd chat client and visualization",
  "author": {
    "name": "Holger Will",
    "email": "h.will@klimapartner.de"
  },
  "homepage": "https://github.com/michiproep/ioBroker.kiwi",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "LLM",
    "MCP",
    "AI",
    "Gemini"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/michiproep/ioBroker.kiwi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@iobroker/adapter-core": "^3.4.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "mingo": "^7.2.4",
    "murmurhash3js": "^3.0.1",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@babel/eslint-parser": "^7.27.5",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^6.3.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.18.0",
    "@types/proxyquire": "^1.3.31",
    "@types/web": "^0.0.239",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "lit": "^3.3.0",
    "prettier": "^3.5.3",
    "proxyquire": "^2.1.3",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js",
    "adapter.mjs"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/michiproep/ioBroker.kiwi/issues"
  },
  "readmeFilename": "README.md",
  "contributors": [
    {
      "name": "Michael Pröpster",
      "email": "imp@outlook.de"
    }
  ]
}
