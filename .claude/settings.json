{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm install)",
			"Bash(npm ci)",
			"Bash(npm outdated:*)",
			"Bash(npm ls:*)",
			"Bash(npm view:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run check:*)",
			"Bash(npm test:*)",
			"Bash(npm run test:*)",
			"Bash(npx @iobroker/repochecker:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr list:*)",
			"Bash(gh run list:*)",
			"Bash(gh run view:*)"
		],
		"ask": ["Bash(npm run release:*)", "Bash(npm publish:*)", "Bash(git push:*)", "Bash(git tag:*)"]
	}
}
