{
	"root": true,
	"env": {
		"es2022": true,
		"node": true,
		"mocha": true
	},
	"extends": ["eslint:recommended"],
	"plugins": [],
	"rules": {
		"indent": [
			"error",
			"tab",
			{
				"SwitchCase": 1
			}
		],
		"no-console": "off",
		"no-unused-vars": [
			"error",
			{
				"ignoreRestSiblings": true,
				"argsIgnorePattern": "^_"
			}
		],
		"no-var": "error",
		"no-trailing-spaces": "error",
		"prefer-const": "error",
		"quotes": [
			"error",
			"double",
			{
				"avoidEscape": true,
				"allowTemplateLiterals": true
			}
		],
		"semi": ["error", "always"]
	},

	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"overrides": [
		{
			"files": ["**/*.mjs"],
			"parser": "@babel/eslint-parser",
			"parserOptions": {
				"ecmaVersion": "latest",
				"sourceType": "module",
				"requireConfigFile": false
			},
			"extends": ["plugin:import/recommended"],
			"rules": {},
			"settings": {
				"import/resolver": {
					"node": {
						"extensions": [".js", ".mjs"]
					}
				}
			}
		}
	]
}
