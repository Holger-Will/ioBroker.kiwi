{
	"i18n": true,
	"type": "tabs",
	"items": {
		"ServerSettings": {
			"type": "panel",
			"label": "Server Settings",
			"items": {
				"webInstance": {
					"type": "instance",
					"label": "Instance of Web Adapter",
					"adapter": "web",
					"tooltip": "Select the instance of the web adapter to use for the chat client.",
					"all": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"aiProvider": {
					"type": "select",
					"label": "AI provider",
					"tooltip": "Used for the chat bot and for the semantic search embeddings. The API key must belong to this provider.",
					"options": [
						{
							"label": "OpenAI",
							"value": "openai"
						},
						{
							"label": "Google Gemini",
							"value": "gemini"
						}
					],
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"apiKey": {
					"type": "password",
					"label": "API Key",
					"tooltip": "API key of the selected AI provider",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"models": {
					"type": "selectSendTo",
					"command": "getModels",
					"jsonData": "{\"provider\": \"${data.aiProvider}\", \"apiKey\": \"${data.apiKey}\"}",
					"alsoDependsOn": ["aiProvider", "apiKey"],
					"manual": true,
					"label": "Select Language Model",
					"help": "Empty: default model of the provider",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				}
			}
		},
		"BotSettings": {
			"type": "panel",
			"label": "Chat Settings",
			"items": {
				"systemPrompt": {
					"type": "text",
					"label": "System Prompt",
					"tooltip": "the system prompt for the integrated chat client.",
					"minRows": 6,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"temperature": {
					"type": "number",
					"min": 0,
					"max": 2,
					"step": 0.1,
					"label": "Temperature",
					"tooltip": "the 'randomness' or 'creativeness' of the response",
					"xs": 12,
					"sm": 6,
					"md": 4,
					"lg": 4,
					"xl": 4
				}
			}
		}
	}
}
